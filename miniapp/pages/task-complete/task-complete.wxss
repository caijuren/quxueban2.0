.page {
  min-height: 100vh;
  background-color: var(--bg-page);
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 600rpx;
  z-index: 0;
  overflow: hidden;
}

.bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(100rpx);
  pointer-events: none;
}

.bg-glow--primary {
  top: -220rpx;
  right: -220rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.28) 0%, transparent 70%);
}

.bg-glow--ai {
  top: 120rpx;
  left: -220rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.22) 0%, transparent 70%);
}

.page-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.task-header {
  padding: calc(var(--status-bar-height, 0) + 24rpx) 40rpx 32rpx;
}

.task-category {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(244, 63, 122, 0.12);
  border: 1rpx solid rgba(244, 63, 122, 0.25);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--primary-light);
  margin-bottom: 20rpx;
}

.task-focus {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.3;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.task-meta-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.04);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
}

.form-card {
  margin: 0 32rpx 24rpx;
  background: linear-gradient(145deg, rgba(17, 21, 34, 0.95), rgba(26, 31, 53, 0.6));
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.status-options,
.quality-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.status-option,
.quality-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-md);
  color: var(--text-secondary);
  font-size: 26rpx;
  transition: all 0.2s;
}

.status-option.active,
.quality-option.active {
  background: rgba(244, 63, 122, 0.12);
  border-color: rgba(244, 63, 122, 0.4);
  color: var(--primary-light);
  box-shadow: 0 0 24rpx rgba(244, 63, 122, 0.15);
}

.quality-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 12rpx;
  display: block;
}

.quality-label {
  font-size: 24rpx;
}

.progress-slider {
  margin: 0;
}

.duration-input {
  height: 88rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--text-muted);
}

.note-textarea {
  width: 100%;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item,
.image-add {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx dashed rgba(255, 255, 255, 0.12);
  color: var(--text-secondary);
}

.image-add-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  display: block;
}

.image-add-text {
  font-size: 24rpx;
}

.audio-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(139, 92, 246, 0.1);
  border: 1rpx solid rgba(139, 92, 246, 0.25);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.audio-preview-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.audio-preview-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.audio-preview-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.audio-delete {
  width: 44rpx;
  height: 44rpx;
  background: rgba(244, 63, 122, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.voice-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(244, 63, 122, 0.2), rgba(139, 92, 246, 0.2));
  border: 2rpx solid rgba(244, 63, 122, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--primary-light);
  box-shadow: 0 8rpx 40rpx rgba(244, 63, 122, 0.2);
}

.voice-btn.recording {
  background: linear-gradient(135deg, rgba(244, 63, 122, 0.4), rgba(139, 92, 246, 0.4));
  box-shadow: 0 0 60rpx rgba(244, 63, 122, 0.5);
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.voice-btn-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
  display: block;
}

.voice-btn-text {
  font-size: 26rpx;
}

.voice-recording-tip {
  font-size: 24rpx;
  color: var(--primary-light);
}

.transcript-box {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.transcript-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.transcript-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.transcript-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.transcript-btn {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  margin: 0;
}

.form-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--bg-page) 0%, rgba(9, 11, 18, 0.95) 70%, transparent 100%);
  pointer-events: auto;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  font-size: 32rpx;
  margin: 0;
}

.voice-toast {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.75);
}

.voice-toast-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
  display: block;
}

.voice-toast-title {
  font-size: 34rpx;
  color: #fff;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.voice-toast-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 24rpx;
}

.voice-toast-duration {
  font-size: 52rpx;
  color: var(--primary-light);
  font-weight: 800;
}
