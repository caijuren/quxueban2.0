.profile-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  background: linear-gradient(180deg, rgba(17, 21, 34, 0.98) 0%, var(--bg-page) 100%);
  z-index: 0;
  overflow: hidden;
}

.profile-bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  pointer-events: none;
}

.profile-bg-glow--primary {
  top: -180rpx;
  right: -180rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.38) 0%, transparent 70%);
}

.profile-bg-glow--ai {
  top: 80rpx;
  left: -180rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.28) 0%, transparent 70%);
}

.profile-scroll {
  flex: 1;
  position: relative;
  z-index: 1;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: calc(var(--status-bar-height, 0) + 60rpx) 32rpx 48rpx;
}

.avatar-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(244, 63, 122, 0.35), rgba(139, 92, 246, 0.35));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 0 80rpx rgba(244, 63, 122, 0.28);
}

.profile-avatar {
  width: 166rpx;
  height: 166rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 72rpx;
  font-weight: 900;
  box-shadow: inset 0 4rpx 20rpx rgba(255, 255, 255, 0.2);
}

.profile-name {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.profile-role-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-full);
  backdrop-filter: blur(12rpx);
}

.role-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: 0 0 12rpx currentColor;
}

.profile-role {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.profile-body {
  padding: 0 32rpx 32rpx;
}

.info-card {
  margin-bottom: 24rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.info-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-icon-text {
  font-size: 30rpx;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 700;
}

.bind-card {
  margin-bottom: 24rpx;
}

.empty-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  text-align: center;
}

.empty-mini-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--bg-elevated), var(--bg-card));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border);
}

.empty-mini-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-mini-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.child-bind-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.child-bind-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.child-bind-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.child-avatar-ring {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  display: flex;
  align-items: center;
  justify-content: center;
}

.child-bind-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.child-bind-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.child-bind-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 700;
}

.child-bind-meta {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.bind-code-btn {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(139, 92, 246, 0.1));
  color: var(--ai-light);
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 28rpx;
  border-radius: var(--radius-full);
  margin: 0;
  line-height: 1;
  border: 1rpx solid rgba(139, 92, 246, 0.25);
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.12);
}

.bind-code-btn::after {
  border: none;
}

.bind-code-btn:active {
  transform: scale(0.96);
}

.menu-card {
  margin-bottom: 24rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.menu-text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.menu-item--danger .menu-text {
  color: var(--primary-light);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-muted);
}

.bind-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8rpx);
}

.bind-modal-content {
  position: relative;
  width: 78%;
  background: linear-gradient(145deg, var(--bg-card), #0f1320);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: var(--shadow-md);
}

.bind-modal-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(244, 63, 122, 0.2), rgba(139, 92, 246, 0.1));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(244, 63, 122, 0.2);
}

.bind-modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.bind-modal-code {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--primary);
  letter-spacing: 20rpx;
  margin-bottom: 24rpx;
  text-shadow: 0 0 40rpx rgba(244, 63, 122, 0.4);
}

.bind-modal-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.bind-modal-expiry {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 40rpx;
}

.bind-modal-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bind-modal-btn {
  width: 100%;
}
