.growth-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  position: relative;
  overflow: hidden;
}

.growth-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  z-index: 0;
  overflow: hidden;
}

.growth-bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(100rpx);
  pointer-events: none;
}

.growth-bg-glow--primary {
  top: -200rpx;
  right: -200rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.32) 0%, transparent 70%);
}

.growth-bg-glow--ai {
  top: 100rpx;
  left: -200rpx;
  width: 460rpx;
  height: 460rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.26) 0%, transparent 70%);
}

.growth-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.growth-header {
  padding: calc(var(--status-bar-height, 0) + 40rpx) 32rpx 32rpx;
}

.growth-title {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.growth-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.hero-card {
  margin: 0 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 28rpx;
}

.hero-ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: conic-gradient(var(--primary) 0%, var(--primary) var(--completion-deg, 0deg), rgba(255, 255, 255, 0.06) var(--completion-deg, 0deg), rgba(255, 255, 255, 0.06) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 0 60rpx rgba(244, 63, 122, 0.2);
}

.hero-inner {
  width: 232rpx;
  height: 232rpx;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero-value {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--primary-light);
  line-height: 1.1;
}

.hero-label {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.hero-stats {
  width: 100%;
  display: flex;
  justify-content: space-around;
}

.hero-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.hero-stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.hero-stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.section-card {
  margin: 0 32rpx 24rpx;
}

.weekly-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 0;
  background: rgba(255, 255, 255, 0.03);
  border-radius: var(--radius-md);
}

.summary-value {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.summary-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.progress-track {
  height: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  border-radius: var(--radius-full);
  transition: width 0.4s ease;
}

.empty-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  text-align: center;
}

.empty-mini-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-mini-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.badge-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.badge-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid;
}

.badge-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.badge-icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.badge-info {
  flex: 1;
  min-width: 0;
}

.badge-name {
  font-size: 30rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 6rpx;
}

.badge-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.badge-level {
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.milestone-list {
  display: flex;
  flex-direction: column;
}

.milestone-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.milestone-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.milestone-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.milestone-body {
  flex: 1;
  min-width: 0;
}

.milestone-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.milestone-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

.milestone-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.milestone-status {
  font-size: 24rpx;
  font-weight: 600;
}

.milestone-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
}
