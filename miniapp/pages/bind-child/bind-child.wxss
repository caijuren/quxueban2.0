.bind-child-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: calc(var(--status-bar-height, 0) + 80rpx) 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bind-child-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 560rpx;
  background: linear-gradient(180deg, rgba(17, 21, 34, 0.98) 0%, var(--bg-page) 100%);
  z-index: 0;
  overflow: hidden;
}

.bind-child-bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
  pointer-events: none;
}

.bind-child-bg-glow--primary {
  top: -220rpx;
  right: -180rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.35) 0%, transparent 70%);
}

.bind-child-bg-glow--ai {
  top: 100rpx;
  left: -200rpx;
  width: 460rpx;
  height: 460rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.28) 0%, transparent 70%);
}

.bind-child-content {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bind-child-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 72rpx;
}

.bind-icon-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(244, 63, 122, 0.3), rgba(139, 92, 246, 0.3));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 0 80rpx rgba(244, 63, 122, 0.28);
}

.bind-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--bg-card), #0f1320);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
}

.bind-icon-img {
  width: 64rpx;
  height: 64rpx;
  display: block;
}

.bind-title {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.bind-desc {
  font-size: 28rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.5;
  max-width: 520rpx;
}

.bind-code-section {
  margin-bottom: 64rpx;
}

.code-input-wrapper {
  position: relative;
  width: 100%;
  height: 128rpx;
  margin-bottom: 24rpx;
}

.code-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
  caret-color: transparent;
}

.code-cells {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 1;
}

.code-cell {
  flex: 1;
  height: 100%;
  background: linear-gradient(145deg, var(--bg-card), #0f1320);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.code-cell--filled {
  border-color: var(--border-strong);
}

.code-cell--active {
  border-color: rgba(244, 63, 122, 0.6);
  box-shadow: 0 0 24rpx rgba(244, 63, 122, 0.2);
}

.code-cell-text {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.code-hint {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

.bind-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.bind-btn {
  width: 100%;
}
