.bind-child-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.bind-child-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.bind-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.bind-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.bind-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 64rpx;
  line-height: 1.6;
}

.bind-input {
  width: 100%;
  height: 100rpx;
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  font-size: 36rpx;
  color: var(--text-primary);
  text-align: center;
  letter-spacing: 16rpx;
  margin-bottom: 48rpx;
}

.input-placeholder {
  color: var(--text-tertiary);
  letter-spacing: 4rpx;
  font-size: 28rpx;
}

.bind-btn {
  width: 100%;
  margin-bottom: 24rpx;
}
