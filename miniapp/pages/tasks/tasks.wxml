<view class="tasks-page" style="--status-bar-height: {{statusBarHeight}}px;">
  <view class="tasks-bg">
    <view class="tasks-bg-glow tasks-bg-glow--primary"></view>
    <view class="tasks-bg-glow tasks-bg-glow--ai"></view>
  </view>

  <!-- 顶部 Header -->
  <view class="tasks-header">
    <view class="header-top">
      <view class="date-section">
        <text class="greeting">{{isGuest ? '欢迎体验' : '今日任务'}}</text>
        <view class="date-row">
          <text class="today-name">{{todayName}}</text>
          <text class="today-date">{{todayDate}}</text>
        </view>
      </view>
      <view class="header-actions">
        <view wx:if="{{isGuest}}" class="user-pill guest-pill" bindtap="goLogin">
          <view class="user-avatar-small" style="background-color: #64748B;">
            <text>游</text>
          </view>
          <text class="user-name-small">登录</text>
        </view>
        <view wx:elif="{{activeRole === 'parent'}}" class="user-pill" bindtap="openChildPicker">
          <view
            class="user-avatar-small"
            style="background-color: {{selectedChild ? (selectedChild.avatarColor || '#F43F5E') : '#64748B'}};"
          >
            <text>{{selectedChild ? selectedChild.name[0] : '?'}}</text>
          </view>
          <text class="user-name-small">{{selectedChild ? selectedChild.name : '选择孩子'}}</text>
          <image src="/assets/icons/arrow-right.svg" class="user-arrow" mode="aspectFit" />
        </view>
        <view wx:else class="user-pill">
          <view
            class="user-avatar-small"
            style="background-color: {{selectedChild ? (selectedChild.avatarColor || '#F43F5E') : '#64748B'}};"
          >
            <text>{{selectedChild ? selectedChild.name[0] : '?'}}</text>
          </view>
          <text class="user-name-small">{{selectedChild ? selectedChild.name : '选择孩子'}}</text>
        </view>

      </view>
    </view>

    <view class="progress-card">
      <view class="progress-left">
        <text class="progress-label">今日完成度</text>
        <text class="progress-rate">{{doneCount}}<text class="progress-total">/{{totalCount}}</text></text>
      </view>
      <view class="progress-right">
        <view class="progress-bar-bg">
          <view
            class="progress-bar-fill"
            style="width: {{totalCount ? (doneCount / totalCount * 100) : 0}}%;"
          ></view>
        </view>
        <text class="progress-text">{{progressPercent}}% 已完成</text>
      </view>
    </view>
  </view>

  <!-- 游客提示 -->
  <view wx:if="{{isGuest}}" class="guest-banner" bindtap="goLogin">
    <image src="/assets/icons/sparkle.svg" class="guest-banner-icon" mode="aspectFit" />
    <view class="guest-banner-text">
      <text class="guest-banner-title">游客模式</text>
      <text class="guest-banner-desc">登录后可查看真实任务并记录学习成长</text>
    </view>
    <image src="/assets/icons/arrow-right.svg" class="guest-banner-arrow" mode="aspectFit" />
  </view>

  <!-- 任务列表 -->
  <scroll-view scroll-y class="tasks-list">
    <view wx:if="{{loading}}" class="loading-wrapper">
      <view class="loading-spinner"></view>
    </view>

    <view wx:elif="{{tasks.length === 0}}" class="empty-state">
      <view class="empty-icon">
        <image src="/assets/icons/leaf.svg" class="empty-icon-img" mode="aspectFit" />
      </view>
      <text class="empty-title">今天没有安排任务</text>
      <text class="empty-desc">可以去 Web 端制定周计划</text>
    </view>

    <view wx:else class="task-groups">
      <view class="task-group" wx:if="{{hasPendingTasks}}">
        <view class="group-header">
          <view class="group-dot" style="background-color: var(--primary);"></view>
          <text class="group-title">待完成</text>
          <text class="group-count">{{pendingCount}}</text>
        </view>
        <view
          wx:for="{{tasks}}"
          wx:key="id"
          wx:if="{{item.status !== 'done'}}"
          class="task-card"
        >
          <view
            class="category-line"
            style="background-color: {{getCategoryColor(item.category)}};"
          ></view>
          <view class="task-content">
            <view class="task-main">
              <view class="task-title-row">
                <text class="task-title">{{item.focus}}</text>
              </view>
              <view class="task-tags">
                <view
                  class="category-tag"
                  style="color: {{getCategoryColor(item.category)}}; background-color: {{getCategoryColor(item.category)}}15;"
                >
                  {{getCategoryLabel(item.category)}}
                </view>
                <view class="meta-item">
                  <image src="/assets/icons/clock.svg" class="meta-icon" mode="aspectFit" />
                  <text>{{item.duration || '30分钟'}}</text>
                </view>
              </view>
              <view wx:if="{{item.evidence.images.length || item.evidence.audios.length || item.evidence.transcript}}" class="evidence-preview">
                <view
                  wx:for="{{item.evidence.images}}"
                  wx:for-item="imgUrl"
                  wx:key="imgUrl"
                  class="evidence-image"
                  bindtap="previewImage"
                  data-url="{{imgUrl}}"
                >
                  <image src="{{imgUrl}}" mode="aspectFill" lazy-load />
                </view>
                <view
                  wx:for="{{item.evidence.audios}}"
                  wx:for-item="audioUrl"
                  wx:key="audioUrl"
                  class="evidence-audio"
                  bindtap="playAudio"
                  data-url="{{audioUrl}}"
                >
                  <image src="/assets/icons/speaker.svg" class="evidence-audio-icon" mode="aspectFit" />
                  <text>语音</text>
                </view>
              </view>
              <view wx:if="{{item.evidence.transcript}}" class="transcript-preview">
                <image src="/assets/icons/document.svg" class="transcript-icon" mode="aspectFit" />
                <text class="transcript-text">{{item.evidence.transcript}}</text>
              </view>
            </view>
            <button
              class="check-btn"
              bindtap="completeTask"
              data-task="{{item}}"
              disabled="{{completingTaskId === item.id}}"
            >
              {{completingTaskId === item.id ? '...' : (activeRole === 'parent' ? '代打卡' : '打卡')}}
            </button>
          </view>
        </view>
      </view>

      <view class="task-group" wx:if="{{hasDoneTasks}}">
        <view class="group-header">
          <view class="group-dot" style="background-color: var(--success);"></view>
          <text class="group-title">已完成</text>
          <text class="group-count">{{doneCount}}</text>
        </view>
        <view
          wx:for="{{tasks}}"
          wx:key="id"
          wx:if="{{item.status === 'done'}}"
          class="task-card task-done"
        >
          <view
            class="category-line"
            style="background-color: {{getCategoryColor(item.category)}};"
          ></view>
          <view class="task-content">
            <view class="task-main">
              <view class="task-title-row">
                <text class="task-title">{{item.focus}}</text>
                <view class="done-badge">
                  <image src="/assets/icons/check.svg" class="done-badge-img" mode="aspectFit" />
                </view>
              </view>
              <view class="task-tags">
                <text class="meta-item">{{item.duration || '30分钟'}}</text>
              </view>
              <view wx:if="{{item.evidence.images.length || item.evidence.audios.length || item.evidence.transcript}}" class="evidence-preview">
                <view
                  wx:for="{{item.evidence.images}}"
                  wx:for-item="imgUrl"
                  wx:key="imgUrl"
                  class="evidence-image"
                  bindtap="previewImage"
                  data-url="{{imgUrl}}"
                >
                  <image src="{{imgUrl}}" mode="aspectFill" lazy-load />
                </view>
                <view
                  wx:for="{{item.evidence.audios}}"
                  wx:for-item="audioUrl"
                  wx:key="audioUrl"
                  class="evidence-audio"
                  bindtap="playAudio"
                  data-url="{{audioUrl}}"
                >
                  <image src="/assets/icons/speaker.svg" class="evidence-audio-icon" mode="aspectFit" />
                  <text>语音</text>
                </view>
              </view>
              <view wx:if="{{item.evidence.transcript}}" class="transcript-preview">
                <image src="/assets/icons/document.svg" class="transcript-icon" mode="aspectFit" />
                <text class="transcript-text">{{item.evidence.transcript}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="safe-area-bottom" style="height: calc(128rpx + env(safe-area-inset-bottom));"></view>
  </scroll-view>

  <!-- 录音 Modal -->
  <view wx:if="{{recordingTaskId}}" class="voice-modal" catchtouchmove="preventTouchMove">
    <view class="voice-modal-mask" bindtap="closeVoiceModal"></view>
    <view class="voice-modal-content">
      <image src="/assets/icons/mic.svg" class="voice-modal-icon" mode="aspectFit" />
      <text class="voice-modal-title">{{isRecording ? '录音中...' : '按住录音'}}</text>
      <text class="voice-modal-desc">{{isRecording ? '松开手指结束录音' : '按住下方按钮开始录音'}}</text>
      <text wx:if="{{isRecording}}" class="voice-duration">{{formatDuration(recordDuration)}}</text>

      <view
        class="voice-record-btn {{isRecording ? 'recording' : ''}}"
        bindtouchstart="onVoiceRecordStart"
        bindtouchend="onVoiceRecordEnd"
        bindtouchcancel="onVoiceRecordEnd"
      >
        <image src="/assets/icons/mic.svg" class="voice-record-icon" mode="aspectFit" />
      </view>

      <button class="voice-cancel-btn btn-ghost" bindtap="closeVoiceModal">取消</button>
    </view>
  </view>

  <!-- 切换孩子面板 -->
  <view wx:if="{{childPickerVisible}}" class="child-picker" catchtouchmove="preventTouchMove">
    <view class="child-picker-mask" bindtap="closeChildPicker"></view>
    <view class="child-picker-sheet">
      <view class="child-picker-header">
        <view class="child-picker-title">切换孩子</view>
        <view class="child-picker-close" bindtap="closeChildPicker">
          <image src="/assets/icons/close.svg" class="small-icon" mode="aspectFit" />
        </view>
      </view>
      <view class="child-picker-list">
        <view
          wx:for="{{children}}"
          wx:key="id"
          class="child-picker-row {{selectedChild && selectedChild.id === item.id ? 'child-picker-row--active' : ''}}"
          bindtap="selectChildInPicker"
          data-child="{{item}}"
        >
          <view class="child-picker-avatar-ring">
            <view
              class="child-picker-avatar"
              style="background-color: {{item.avatarColor || '#F43F5E'}};"
            >
              <text>{{item.name[0]}}</text>
            </view>
          </view>
          <view class="child-picker-info">
            <text class="child-picker-name">{{item.name}}</text>
            <text class="child-picker-meta">{{item.grade}}年级</text>
          </view>
          <view wx:if="{{selectedChild && selectedChild.id === item.id}}" class="child-picker-check">
            <image src="/assets/icons/check.svg" class="small-icon" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view class="child-picker-actions">
        <button class="btn-ghost child-picker-btn" bindtap="closeChildPicker">取消</button>
      </view>
    </view>
  </view>
</view>
