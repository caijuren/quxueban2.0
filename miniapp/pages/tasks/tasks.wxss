.tasks-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  display: flex;
  flex-direction: column;
}

.tasks-header {
  background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-page) 100%);
  padding: calc(var(--status-bar-height, 0) + 24rpx) 32rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.today-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.today-date {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.child-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background-color: var(--bg-elevated);
  border-radius: 40rpx;
  border: 1rpx solid var(--border);
}

.child-avatar-small {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.child-name-small {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.switch-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.profile-entry {
  padding: 12rpx 20rpx;
  background-color: var(--bg-elevated);
  border-radius: 40rpx;
  border: 1rpx solid var(--border);
}

.profile-entry-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.progress-section {
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.progress-rate {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.progress-bar {
  height: 12rpx;
  background-color: var(--bg-elevated);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.tasks-list {
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 80rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(244, 63, 122, 0.2);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.task-groups {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.task-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  padding-left: 8rpx;
}

.task-card {
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
}

.task-done {
  opacity: 0.7;
}

.category-line {
  width: 8rpx;
  flex-shrink: 0;
}

.task-content {
  flex: 1;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.task-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  flex-wrap: wrap;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
}

.category-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.task-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.check-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  padding: 0;
}

.check-btn::after {
  border: none;
}

.check-btn[disabled] {
  opacity: 0.6;
}

.done-badge {
  font-size: 22rpx;
  color: var(--success);
  background-color: rgba(34, 197, 94, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.evidence-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.evidence-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid var(--border);
  background-color: var(--bg-elevated);
}

.evidence-image image {
  width: 100%;
  height: 100%;
}

.evidence-audio {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background-color: rgba(139, 92, 246, 0.15);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--ai-light);
}

.voice-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
}

.voice-modal-content {
  position: relative;
  width: 80%;
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.voice-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.voice-modal-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}

.voice-duration {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 32rpx;
  font-variant-numeric: tabular-nums;
}

.voice-record-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(244, 63, 122, 0.3);
  transition: transform 0.2s;
}

.voice-record-btn.recording {
  transform: scale(1.1);
  box-shadow: 0 16rpx 48rpx rgba(244, 63, 122, 0.5);
}

.voice-record-icon {
  font-size: 72rpx;
}

.voice-cancel-btn {
  width: 100%;
}
