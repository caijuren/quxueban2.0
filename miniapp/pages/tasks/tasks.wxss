.tasks-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.tasks-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  background: linear-gradient(180deg, rgba(17, 21, 34, 0.98) 0%, var(--bg-page) 100%);
  z-index: 0;
  overflow: hidden;
}

.tasks-bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
  pointer-events: none;
}

.tasks-bg-glow--primary {
  top: -200rpx;
  right: -180rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.32) 0%, transparent 70%);
}

.tasks-bg-glow--ai {
  top: 80rpx;
  left: -180rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.25) 0%, transparent 70%);
}

.tasks-header {
  position: relative;
  z-index: 1;
  background: linear-gradient(180deg, rgba(17, 21, 34, 0.95) 0%, var(--bg-page) 100%);
  padding: calc(var(--status-bar-height, 0) + 24rpx) 32rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.date-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.greeting {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

.date-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.today-name {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.today-date {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 18rpx 10rpx 10rpx;
  background: linear-gradient(145deg, var(--bg-elevated), var(--bg-card));
  border-radius: var(--radius-full);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}

.user-pill:active {
  opacity: 0.8;
}

.guest-pill {
  background: rgba(255, 255, 255, 0.06);
}

.user-avatar-small {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.user-name-small {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.user-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-left: 4rpx;
}

.icon-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--bg-elevated), var(--bg-card));
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.icon-btn:active {
  opacity: 0.8;
}

.icon-text {
  font-size: 32rpx;
}

.progress-card {
  background: linear-gradient(135deg, var(--bg-card) 0%, #1a1f35 100%);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-shadow: var(--shadow-sm);
}

.progress-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.progress-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.progress-rate {
  font-size: 52rpx;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1;
}

.progress-total {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-tertiary);
}

.progress-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-bar-bg {
  height: 14rpx;
  background-color: var(--bg-elevated);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  border-radius: var(--radius-full);
  transition: width 0.6s ease;
  box-shadow: 0 0 16rpx rgba(244, 63, 122, 0.4);
}

.progress-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: right;
}

.guest-banner {
  position: relative;
  z-index: 1;
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(244, 63, 122, 0.1));
  border: 1rpx solid rgba(139, 92, 246, 0.25);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.guest-banner-icon {
  font-size: 40rpx;
}

.guest-banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.guest-banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.guest-banner-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.guest-banner-arrow {
  font-size: 40rpx;
  color: var(--ai-light);
}

.tasks-list {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.task-groups {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.task-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 8rpx;
}

.group-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.group-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.group-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  background-color: var(--bg-elevated);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  margin-left: 8rpx;
}

.task-card {
  background: linear-gradient(145deg, var(--bg-card), #0f1320);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.task-card:active {
  transform: scale(0.99);
}

.task-done {
  opacity: 0.75;
}

.task-done .task-title {
  text-decoration: line-through;
  color: var(--text-tertiary);
}

.category-line {
  width: 8rpx;
  flex-shrink: 0;
}

.task-content {
  flex: 1;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.task-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.task-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
  flex: 1;
}

.task-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.category-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.task-materials {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.material-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: rgba(255, 255, 255, 0.04);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.check-btn {
  flex-shrink: 0;
  width: 128rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(244, 63, 122, 0.25);
}

.check-btn::after {
  border: none;
}

.check-btn[disabled] {
  opacity: 0.6;
  box-shadow: none;
}

.done-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(34, 197, 94, 0.15);
  color: var(--success);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.evidence-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 4rpx;
}

.evidence-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1rpx solid var(--border);
  background-color: var(--bg-elevated);
}

.evidence-image image {
  width: 100%;
  height: 100%;
}

.evidence-audio {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(139, 92, 246, 0.08));
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--ai-light);
}

.voice-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8rpx);
}

.voice-modal-content {
  position: relative;
  width: 78%;
  background: linear-gradient(145deg, var(--bg-card), #0f1320);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: var(--shadow-md);
}

.voice-modal-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.voice-modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.voice-modal-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.voice-duration {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--primary);
  margin-bottom: 40rpx;
  font-variant-numeric: tabular-nums;
}

.voice-record-btn {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: var(--shadow-glow);
  transition: transform 0.2s;
}

.voice-record-btn.recording {
  transform: scale(1.08);
  box-shadow: 0 16rpx 48rpx rgba(244, 63, 122, 0.5);
}

.voice-record-icon {
  font-size: 72rpx;
  color: #fff;
}

.voice-cancel-btn {
  width: 100%;
}

/* 切换孩子面板 */
.child-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.child-picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8rpx);
}

.child-picker-sheet {
  position: relative;
  background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-page) 100%);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.child-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.child-picker-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.child-picker-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-tertiary);
}

.child-picker-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-height: 720rpx;
  overflow-y: auto;
}

.child-picker-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: linear-gradient(145deg, var(--bg-elevated), var(--bg-card));
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
}

.child-picker-row--active {
  border-color: rgba(244, 63, 122, 0.45);
  background: linear-gradient(145deg, rgba(244, 63, 122, 0.12), var(--bg-card));
}

.child-picker-row:active {
  transform: scale(0.99);
}

.child-picker-avatar-ring {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.child-picker-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.child-picker-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.child-picker-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.child-picker-meta {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.child-picker-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.15);
  color: var(--success);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.child-picker-actions {
  margin-top: 24rpx;
}

.child-picker-btn {
  width: 100%;
}
