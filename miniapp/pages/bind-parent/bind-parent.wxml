<view class="bind-child-page" style="--status-bar-height: {{statusBarHeight}}px;">
  <view class="bind-child-bg">
    <view class="bind-child-bg-glow bind-child-bg-glow--primary"></view>
    <view class="bind-child-bg-glow bind-child-bg-glow--ai"></view>
  </view>

  <view class="bind-child-content">
    <view class="bind-child-header">
      <view class="bind-icon-ring">
        <view class="bind-icon">
          <text>👩‍👧</text>
        </view>
      </view>
      <text class="bind-title">绑定家长账号</text>
      <text class="bind-desc">请家长在 Web 端「我的账户 → 微信绑定」生成绑定码，然后在这里输入</text>
    </view>

    <view class="bind-code-section">
      <view class="code-input-wrapper" bindtap="focusInput">
        <input
          class="code-input"
          type="number"
          maxlength="6"
          placeholder=""
          value="{{bindCode}}"
          focus="{{inputFocus}}"
          bindinput="onInput"
          bindfocus="onFocus"
          bindblur="onBlur"
        />
        <view class="code-cells">
          <view
            wx:for="{{codeCells}}"
            wx:key="index"
            class="code-cell {{focusIndex === index && inputFocus ? 'code-cell--active' : ''}} {{item ? 'code-cell--filled' : ''}}"
          >
            <text class="code-cell-text">{{item}}</text>
          </view>
        </view>
      </view>

      <text class="code-hint">6 位数字绑定码</text>
    </view>

    <view class="bind-actions">
      <button
        class="btn-primary bind-btn"
        bindtap="onBind"
        disabled="{{loading || bindCode.length !== 6}}"
      >
        {{loading ? '绑定中...' : '确认绑定'}}
      </button>

      <button class="btn-ghost bind-btn" bindtap="goBack">返回</button>
    </view>
  </view>
</view>
