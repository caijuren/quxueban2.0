.role-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: calc(var(--status-bar-height, 0) + 60rpx) 40rpx 48rpx;
  box-sizing: border-box;
}

.role-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 560rpx;
  background: linear-gradient(180deg, rgba(17, 21, 34, 0.98) 0%, var(--bg-page) 100%);
  z-index: 0;
  overflow: hidden;
}

.role-bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
  pointer-events: none;
}

.role-bg-glow--primary {
  top: -200rpx;
  right: -180rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(244, 63, 122, 0.35) 0%, transparent 70%);
}

.role-bg-glow--ai {
  top: 120rpx;
  left: -200rpx;
  width: 460rpx;
  height: 460rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.28) 0%, transparent 70%);
}

.role-content {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.role-header {
  margin-bottom: 64rpx;
}

.role-brand {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-full);
  margin-bottom: 40rpx;
  width: fit-content;
}

.role-brand-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--primary);
  box-shadow: 0 0 12rpx var(--primary);
}

.role-brand-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.role-title {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.role-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
}

.role-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

