.role-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding: 120rpx 40rpx 48rpx;
  box-sizing: border-box;
}

.role-header {
  margin-bottom: 60rpx;
}

.role-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.role-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.role-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.role-card {
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: transform 0.2s;
}

.role-card:active {
  transform: scale(0.98);
}

.role-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.parent-icon {
  background: linear-gradient(135deg, rgba(244, 63, 122, 0.2), rgba(244, 63, 122, 0.05));
}

.child-icon {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(139, 92, 246, 0.05));
}

.icon-text {
  font-size: 56rpx;
}

.role-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.role-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
}

.child-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.child-card {
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.child-card:active {
  opacity: 0.8;
}

.child-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.child-avatar-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

.child-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.child-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.child-meta {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.child-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary);
}

.back-btn {
  width: 100%;
}
