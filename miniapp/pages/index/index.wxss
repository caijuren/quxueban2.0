.index-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: calc(var(--status-bar-height, 0) + 80rpx) 48rpx 48rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120rpx);
  opacity: 0.35;
  pointer-events: none;
}

.bg-glow-1 {
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, var(--primary) 0%, transparent 70%);
  top: -200rpx;
  right: -200rpx;
}

.bg-glow-2 {
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, var(--ai) 0%, transparent 70%);
  bottom: 200rpx;
  left: -200rpx;
}

.index-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 72rpx;
}

.logo-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(244, 63, 122, 0.3), rgba(139, 92, 246, 0.3));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 0 80rpx rgba(244, 63, 122, 0.3);
}

.logo {
  width: 168rpx;
  height: 168rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--primary), var(--ai));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 4rpx 20rpx rgba(255, 255, 255, 0.2);
}

.logo-text {
  font-size: 88rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.brand-name {
  font-size: 56rpx;
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 12rpx;
}

.brand-slogan {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}

.brand-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 28rpx;
  background: rgba(244, 63, 122, 0.12);
  border: 1rpx solid rgba(244, 63, 122, 0.25);
  border-radius: var(--radius-full);
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--primary-light);
  box-shadow: 0 0 12rpx var(--primary);
}

.tag-text {
  font-size: 24rpx;
  color: var(--primary-light);
  font-weight: 500;
}

.feature-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-card {
  background: linear-gradient(145deg, rgba(17, 21, 34, 0.9), rgba(26, 31, 53, 0.6));
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  backdrop-filter: blur(20rpx);
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.feature-card:active {
  transform: scale(0.99);
}

.feature-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-text {
  font-size: 44rpx;
}

.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.feature-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

.index-footer {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  position: relative;
  z-index: 1;
  margin-top: 48rpx;
  padding-top: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 128rpx);
}

.index-btn {
  width: 100%;
}

.privacy-text {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}
