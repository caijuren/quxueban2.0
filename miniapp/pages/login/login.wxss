.login-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 80rpx 48rpx 48rpx;
  box-sizing: border-box;
}

.login-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, var(--primary), var(--ai));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(244, 63, 122, 0.25);
}

.logo-text {
  font-size: 80rpx;
  font-weight: 700;
  color: #fff;
}

.brand-name {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.brand-slogan {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 0 48rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.feature-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: var(--primary);
}

.feature-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.login-footer {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.login-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.privacy-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
}
