<view class="login-page">
  <view class="bg-glow bg-glow-1"></view>
  <view class="bg-glow bg-glow-2"></view>

  <view class="login-content">
    <view class="brand-section">
      <view class="logo-ring">
        <view class="logo">
          <text class="logo-text">趣</text>
        </view>
      </view>
      <text class="brand-name">趣学伴</text>
      <text class="brand-slogan">家庭学习规划中心</text>
    </view>

    <view class="feature-cards">
      <view class="feature-card">
        <view class="feature-icon" style="background: linear-gradient(135deg, rgba(244, 63, 122, 0.2), rgba(244, 63, 122, 0.05)); color: var(--primary-light);">
          <text class="icon-text">✓</text>
        </view>
        <view class="feature-info">
          <text class="feature-title">微信一键登录</text>
          <text class="feature-desc">无需注册，安全快捷</text>
        </view>
      </view>

      <view class="feature-card">
        <view class="feature-icon" style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(139, 92, 246, 0.05)); color: var(--ai-light);">
          <text class="icon-text">🔒</text>
        </view>
        <view class="feature-info">
          <text class="feature-title">数据安全</text>
          <text class="feature-desc">学习数据云端同步，换机不丢失</text>
        </view>
      </view>
    </view>
  </view>

  <view class="login-footer">
    <button
      class="btn-primary login-btn"
      bindtap="loginAsParent"
      disabled="{{loading}}"
    >
      {{loading ? '登录中...' : '微信一键登录'}}
    </button>

    <button
      class="btn-ghost login-btn"
      bindtap="goBindChild"
      disabled="{{loading}}"
    >
      我是孩子，绑定微信
    </button>

    <text class="privacy-text">登录即表示同意《用户协议》和《隐私政策》</text>
  </view>
</view>
