page {
  --bg-page: #090B12;
  --bg-card: #111522;
  --bg-elevated: #1A1F35;
  --primary: #F43F7A;
  --primary-light: #FB7185;
  --ai: #8B5CF6;
  --ai-light: #A78BFA;
  --text-primary: #F1F5F9;
  --text-secondary: #CBD5E1;
  --text-tertiary: #94A3B8;
  --border: rgba(255, 255, 255, 0.08);
  --success: #22C55E;
  --warning: #F59E0B;

  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background-color: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border-radius: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: var(--bg-elevated);
  color: var(--text-primary);
  border-radius: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: 1rpx solid var(--border);
}

.btn-secondary::after {
  border: none;
}

.btn-ghost {
  background-color: transparent;
  color: var(--text-secondary);
  border-radius: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  text-align: center;
  border: 1rpx solid var(--border);
}

.btn-ghost::after {
  border: none;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.badge-primary {
  background-color: rgba(244, 63, 122, 0.15);
  color: var(--primary-light);
}

.badge-ai {
  background-color: rgba(139, 92, 246, 0.15);
  color: var(--ai-light);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--bg-elevated);
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
