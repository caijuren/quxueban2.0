<view class="tab-bar" style="padding-bottom: {{safeAreaBottom}}px;" catchtouchmove="preventTouchMove">
  <view class="tab-bar-bg">
    <view class="tab-bar-glow"></view>
  </view>

  <view
    class="tab-bar-item {{selected === 0 ? 'active' : ''}}"
    data-index="0"
    data-url="/pages/index/index"
    bindtap="switchTab"
  >
    <view class="tab-icon">
      <image src="/assets/icons/home{{selected === 0 ? '-active' : ''}}.svg" class="tab-icon-img" mode="aspectFit" />
    </view>
    <view class="tab-label">首页</view>
    <view wx:if="{{selected === 0}}" class="tab-indicator"></view>
  </view>

  <view
    class="tab-bar-item {{selected === 1 ? 'active' : ''}}"
    data-index="1"
    data-url="/pages/tasks/tasks"
    bindtap="switchTab"
  >
    <view class="tab-icon">
      <image src="/assets/icons/tasks{{selected === 1 ? '-active' : ''}}.svg" class="tab-icon-img" mode="aspectFit" />
    </view>
    <view class="tab-label">今日任务</view>
    <view wx:if="{{selected === 1}}" class="tab-indicator"></view>
  </view>

  <view
    class="tab-bar-item {{selected === 2 ? 'active' : ''}}"
    data-index="2"
    data-url="/pages/profile/profile"
    bindtap="switchTab"
  >
    <view class="tab-icon">
      <image src="/assets/icons/profile{{selected === 2 ? '-active' : ''}}.svg" class="tab-icon-img" mode="aspectFit" />
    </view>
    <view class="tab-label">我的</view>
    <view wx:if="{{selected === 2}}" class="tab-indicator"></view>
  </view>
</view>
