.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-around;
  z-index: 9999;
  box-sizing: border-box;
}

.tab-bar-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(9, 11, 18, 0.92);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.tab-bar-glow {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 80rpx;
  background: radial-gradient(ellipse at center, rgba(244, 63, 122, 0.12), transparent 70%);
  pointer-events: none;
}

.tab-bar-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 14rpx;
  width: 33.33%;
  height: 112rpx;
  color: rgba(203, 213, 225, 0.55);
  transition: color 0.2s ease;
}

.tab-bar-item.active {
  color: #F43F7A;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 8rpx;
  filter: grayscale(0.3);
  transition: transform 0.2s ease;
}

.tab-bar-item.active .tab-icon {
  transform: scale(1.1);
  filter: grayscale(0);
}

.tab-label {
  font-size: 22rpx;
  line-height: 1;
  font-weight: 500;
}

.tab-indicator {
  position: absolute;
  bottom: 20rpx;
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, #F43F7A, #8B5CF6);
  box-shadow: 0 0 12rpx rgba(244, 63, 122, 0.5);
}
