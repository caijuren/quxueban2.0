generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(PARENT)
  avatarUrl    String?
  phone        String?
  email        String?
  wechatOpenId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children      Child[]
  plans         Plan[]
  weeklyPlans   WeeklyPlan[]
  notifications Notification[]
  settings      UserSetting?
  taskTemplates TaskTemplate[]

  @@index([role])
}

model UserSetting {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme              String   @default("dark-tech")
  fontSize           String   @default("normal")
  density            String   @default("comfortable")
  reducedMotion      Boolean  @default(false)
  defaultLandingPage String   @default("dashboard")
  defaultChildMode   String   @default("last")

  notificationPrefs  Json     @default("{}")
  reminderTime       String   @default("08:00")
  doNotDisturb       Boolean  @default(false)
  doNotDisturbStart  String?
  doNotDisturbEnd    String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Child {
  id           String   @id @default(uuid())
  userId       String
  name         String
  grade        Int
  avatarColor  String   @default("#f43f5e")
  avatarUrl    String?
  targetSchool String?
  currentSchool String?
  birthday     DateTime?
  notes        String?
  routeId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans       Plan[]
  weeklyPlans WeeklyPlan[]

  @@index([userId])
}

model Plan {
  id           String   @id @default(uuid())
  userId       String
  childId      String
  name         String
  type         String
  status       String   @default("draft")
  stage        String
  description  String?
  requirements Json?    @default("[]")
  milestones   Json?    @default("[]")
  targets      Json?    @default("[]")
  probability  Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([childId])
}

model TaskTemplate {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  category      TaskCategory
  gradeMin      Int        @default(1)
  gradeMax      Int        @default(12)
  duration      String     @default("30分钟")
  materials     String[]   @default([])
  description   String?
  routeTags     String[]   @default([])
  milestoneTag  String?

  source        TaskTemplateSource @default(USER)
  isActive      Boolean    @default(true)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([category])
  @@index([source])
}

model WeeklyPlan {
  id             String    @id @default(uuid())
  userId         String
  childId        String
  weekId         String
  tasks          Json      @default("[]")
  publishedAt    DateTime?
  reviewedAt     DateTime?
  parentComment  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, weekId])
  @@index([userId])
  @@index([childId])
}

enum TaskCategory {
  CHINESE
  MATH
  ENGLISH
  SCHOOL
  READING
  SPORT
  INTEREST
  OTHER
}

enum TaskTemplateSource {
  SYSTEM
  USER
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
