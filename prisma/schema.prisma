generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  ADMIN
}

enum FamilyMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum FamilyMemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(PARENT)
  avatarUrl    String?
  phone        String?
  email        String?
  wechatOpenId      String?  @unique
  bindCode          String?  @unique
  bindCodeExpiresAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  children      Child[]
  plans         Plan[]
  weeklyPlans   WeeklyPlan[]
  notifications Notification[]
  settings           UserSetting?
  taskTemplates      TaskTemplate[]
  capabilities       Capability[]
  subjectPlanConfigs SubjectPlanConfig[]
  weeklyPlanTemplates WeeklyPlanTemplate[]
  badges             Badge[]
  pointLogs          PointLog[]
  parentLogs         ParentLog[]
  chatSessions       ChatSession[]

  ownedFamilies    Family[]        @relation("FamilyOwner")
  familyMemberships FamilyMember[]

  @@index([role])
}

model Family {
  id             String   @id @default(uuid())
  name           String
  createdByUserId String
  createdBy      User     @relation("FamilyOwner", fields: [createdByUserId], references: [id], onDelete: Cascade)

  members        FamilyMember[]
  children       Child[]
  invites        FamilyInvite[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdByUserId])
}

model FamilyMember {
  id        String             @id @default(uuid())
  familyId  String
  family    Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      FamilyMemberRole   @default(MEMBER)
  status    FamilyMemberStatus @default(INVITED)
  invitedBy String?
  invitedAt DateTime           @default(now())
  joinedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
  @@index([status])
}

model FamilyInvite {
  id        String   @id @default(uuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  token     String   @unique
  role      FamilyMemberRole @default(MEMBER)
  email     String?
  phone     String?
  invitedBy String?
  invitedAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  usedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([token])
  @@index([email])
  @@index([phone])
}

model UserSetting {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme              String   @default("dark-tech")
  fontSize           String   @default("normal")
  density            String   @default("comfortable")
  reducedMotion      Boolean  @default(false)
  defaultLandingPage String   @default("dashboard")
  defaultChildMode   String   @default("last")

  notificationPrefs  Json     @default("{}")
  reminderTime       String   @default("08:00")
  doNotDisturb       Boolean  @default(false)
  doNotDisturbStart  String?
  doNotDisturbEnd    String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Child {
  id               String   @id @default(uuid())
  userId           String
  familyId         String?
  name             String
  grade            Int
  educationSystem  String   @default("six-three") // 学制：six-three（六三制）或 five-four（五四制）
  avatarColor      String   @default("#f43f5e")
  avatarUrl        String?
  targetSchool     String?
  currentSchool    String?
  birthday         DateTime?
  notes            String?
  routeId          String?
  wechatOpenId     String?  @unique
  bindCode         String?  @unique
  bindCodeExpiresAt DateTime?
  dingTalkWebhook  String? // 钉钉自定义机器人 webhook
  dingTalkSecret   String? // 钉钉机器人加签密钥
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  family       Family?       @relation(fields: [familyId], references: [id], onDelete: SetNull)
  plans        Plan[]
  weeklyPlans  WeeklyPlan[]
  taskTemplates TaskTemplate[]
  learningGoals LearningGoal[]
  milestones   Milestone[]
  subjectPlanConfigs SubjectPlanConfig[]
  weeklyPlanTemplates WeeklyPlanTemplate[]
  badges       Badge[]
  pointLogs    PointLog[]
  parentLogs   ParentLog[]
  chatSessions ChatSession[]

  @@index([userId])
  @@index([familyId])
}

model LearningGoal {
  id          String   @id @default(uuid())
  childId     String

  subject     String   // chinese | math | english | overall
  goalType    String   // reading_count | ability_score | habit | custom
  metricType  String   // count | score | duration | habit
  title       String
  target      String?
  period      String   // 2026春季

  source      String   @default("parent") // parent | ai | system | teacher
  status      String   @default("active") // active | completed | paused

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  milestones  Milestone[]

  @@index([childId])
  @@index([status])
}

model Plan {
  id           String   @id @default(uuid())
  userId       String
  childId      String
  name         String
  type         String
  status       String   @default("draft")
  stage        String
  description  String?
  requirements Json?    @default("[]")
  milestones   Json?    @default("[]")
  targets      Json?    @default("[]")
  probability  Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  planMilestones Milestone[]

  @@index([userId])
  @@index([childId])
}

model Milestone {
  id              String   @id @default(uuid())
  childId         String
  title           String
  description     String?
  targetGrade     Int?
  targetPeriod    String?
  routeId         String?
  source          String   @default("system") // system | parent | ai
  status          String   @default("pending") // pending | in_progress | completed
  dueDate         DateTime?
  completedAt     DateTime?
  certificateUrls String[] @default([])
  score           String?
  notes           String?
  learningGoalId  String?
  planId          String?

  child         Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  learningGoal  LearningGoal? @relation(fields: [learningGoalId], references: [id], onDelete: SetNull)
  plan          Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([childId])
  @@index([status])
  @@index([routeId])
  @@index([learningGoalId])
  @@index([planId])
}

model TaskTemplate {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId       String?
  child         Child?     @relation(fields: [childId], references: [id], onDelete: Cascade)

  title         String
  category      TaskCategory
  duration      String     @default("30分钟")
  difficulty    String?    @default("medium")
  materials     String[]   @default([])
  description   String?
  routeTags     String[]   @default([])
  milestoneTag  String?
  semesterTag   String?
  tags          String[]   @default([])

  source              TaskTemplateSource @default(USER)
  isActive            Boolean    @default(true)
  isFavorite          Boolean    @default(false)
  archivedAt          DateTime?
  useCount            Int        @default(0)
  lastUsedAt          DateTime?

  taskType            TaskType      @default(DAILY)
  frequency           TaskFrequency @default(ONCE)
  customFrequency     Json?
  weeklySchedule      TaskWeeklySchedule @default(AUTO)
  customScheduleDays  String[]      @default([])
  assessmentCriteria  Json          @default("[]")

  capabilityLinks     TaskCapabilityLink[]

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([userId])
  @@index([childId])
  @@index([category])
  @@index([source])
  @@index([archivedAt])
  @@index([isActive])
  @@index([isFavorite])
  @@index([taskType])
  @@index([frequency])
  @@index([weeklySchedule])
}

model Capability {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  category    CapabilityCategory
  description String?
  isSystem    Boolean  @default(false)

  links TaskCapabilityLink[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isSystem])
}

model TaskCapabilityLink {
  id               String @id @default(uuid())
  taskTemplateId   String
  capabilityId     String
  weight           Float  @default(1.0)
  expectedProgress Float  @default(0.0)

  taskTemplate TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([taskTemplateId, capabilityId])
  @@index([taskTemplateId])
  @@index([capabilityId])
}

model WeeklyPlan {
  id                   String    @id @default(uuid())
  userId               String
  childId              String
  weekId               String
  tasks                Json      @default("[]")
  goals                Json?     @default("[]")
  publishedAt          DateTime?
  reviewedAt           DateTime?
  parentComment        String?
  aiSummary            String?   @db.Text
  aiSummaryGeneratedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, weekId])
  @@index([userId])
  @@index([childId])
}

enum TaskCategory {
  SCHOOL
  READING
  SPORT
  INTEREST
  ABILITY
  OTHER
}

enum TaskTemplateSource {
  SYSTEM
  USER
}

enum TaskType {
  DAILY
  MILESTONE
  REMEDIAL
  SPRINT
  DIAGNOSTIC
}

enum TaskFrequency {
  ONCE
  DAILY
  WEEKLY
  CUSTOM
}

enum TaskWeeklySchedule {
  AUTO
  DAILY
  WEEKDAYS
  WEEKENDS
  CUSTOM
}

enum CapabilityCategory {
  CHINESE
  MATH
  ENGLISH
  GENERAL
  EXAM
  ADMISSION
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SubjectPlanConfig {
  id            String   @id @default(uuid())
  userId        String?
  childId       String?
  subject       String
  tracks          Json
  timeAxis        Json
  nodes           Json
  keyAchievements Json
  examTimeline    Json
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([subject, userId, childId])
  @@index([subject])
  @@index([userId])
  @@index([childId])
}

model WeeklyPlanTemplate {
  id          String   @id @default(uuid())
  userId      String
  childId     String?
  name        String
  description String?
  tasks       Json     @default("[]")
  goals       Json?    @default("[]")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([childId])
  @@index([isDefault])
}

model Badge {
  id          String   @id @default(uuid())
  userId      String
  childId     String?
  key         String
  name        String
  description String?
  icon        String?
  color       String?
  level       Int      @default(1)
  unlockedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([userId, childId, key])
  @@index([userId])
  @@index([childId])
  @@index([key])
}

model PointLog {
  id          String   @id @default(uuid())
  userId      String
  childId     String?
  points      Int
  total       Int
  reason      String
  source      String   @default("system")
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([childId])
  @@index([createdAt])
}

model ParentLog {
  id          String   @id @default(uuid())
  userId      String
  childId     String
  date        String
  content     String
  imageUrls   String[] @default([])
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date])
  @@index([userId])
  @@index([childId])
  @@index([date])
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  childId   String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  child    Child?      @relation(fields: [childId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([childId])
  @@index([updatedAt])
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String   // user | assistant
  content   String   @db.Text
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model Publisher {
  id             String  @id @default(uuid())
  name           String  @unique
  shortName      String?
  logoUrl        String?
  website        String?
  strongSubjects String?
  series         String?
  contactEmail   String?
  note           String?

  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model ContentType {
  id              String  @id @default(uuid())
  name            String  @unique
  description     String?
  typicalExamples String?
  usageScenario   String?
  difficultyRange String?

  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Book {
  id                  String  @id @default(uuid())
  bookId              String  @unique
  title               String
  isbn                String?
  author              String?
  editionDate         String?
  editionNumber       String?
  price               Float?
  subject             String
  grade               String
  textbookVersion     String?
  isNewTextbook       String  @default("否")
  difficulty          Int     @default(1)
  targetAudience      String?
  sellingPoints       String? @db.Text
  structureDesc       String? @db.Text
  companionSuggestion String? @db.Text
  coverImageUrl       String?
  jdUrl               String?
  dangdangUrl         String?
  officialUrl         String?
  status              String  @default("在售")
  lastVerifiedAt      DateTime?
  note                String?

  publisher       Publisher   @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  publisherId     String
  contentType     ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)
  contentTypeId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([grade])
  @@index([status])
  @@index([difficulty])
  @@index([publisherId])
  @@index([contentTypeId])
  @@index([isNewTextbook])
}

model AiConfig {
  id        String   @id @default(uuid())
  provider  String   @default("deepseek")
  apiKey    String
  apiUrl    String   @default("https://api.deepseek.com/v1/chat/completions")
  model     String   @default("deepseek-chat")
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
}
