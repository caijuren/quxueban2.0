# 趣学伴 1.0 生产环境变量模板
# 复制本文件为 .env.production 并替换所有占位值

# PostgreSQL 数据库连接串
# Docker Compose 使用 POSTGRES_PASSWORD 连接内置 db 服务。
POSTGRES_PASSWORD="change-me-to-a-strong-database-password"
DATABASE_URL="postgresql://quxueban:change-me-to-a-strong-database-password@localhost:5432/quxueban?schema=public"

# Redis 连接串（可选，用于限流持久化）
# 配置后限流计数改用 Redis，跨容器重启/多实例共享；未配置时自动回退进程内内存限流。
# Docker Compose 内置 redis 服务时使用 redis://redis:6379
REDIS_URL=""

# NextAuth 配置
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="change-me-in-production-min-32-chars-long"
CRON_SECRET="change-me-to-a-random-cron-secret"

# 敏感配置字段加密密钥（用于加密数据库中存储的 AI API Key 等敏感字段）
# 生成方式：openssl rand -base64 48
# ⚠️ 一旦设定不可随意更换，更换会导致已加密数据无法解密
CONFIG_ENCRYPTION_KEY="change-me-min-32-chars-strong-random-key"

# 首次 prisma/seed.ts 创建的默认管理员账号
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"
DEMO_PARENT_USERNAME="parent"
DEMO_PARENT_PASSWORD="change-me-for-demo-account"

# 钉钉自定义机器人推送配置（全局兜底，可选）
# 建议在每个孩子的编辑页面单独配置钉钉机器人；此处作为未配置孩子时的兜底
DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=xxx"
DINGTALK_SECRET="SECxxx"

# AI 日报总结配置（可选）
# 支持任意 OpenAI 兼容接口，如豆包 Ark、DeepSeek、OpenAI 等
# 未配置时将使用内置规则生成总结
AI_API_BASE="https://ark.cn-beijing.volces.com/api/v3"
AI_API_KEY="your-api-key"
AI_MODEL="doubao-pro-32k"

# 文件上传/持久化配置（local 模式）
# 照片、语音等文件默认保存到 public/uploads，Docker 部署已自动挂载 app_uploads 卷持久化
# 如需使用 S3/OSS 等对象存储，请后续扩展 lib/storage.ts
# UPLOAD_LOCAL_ROOT="/app/public/uploads"
# UPLOAD_PUBLIC_BASE_URL="https://your-domain.com"

# 微信小程序配置（可选）
# 用于小程序端微信登录
WECHAT_MINIAPP_APPID="your-miniapp-appid"
WECHAT_MINIAPP_SECRET="your-miniapp-secret"
# 小程序独立 JWT 密钥，未配置时回退使用 NEXTAUTH_SECRET
MINIAPP_JWT_SECRET="change-me-in-production-min-32-chars-long"
# 微信小程序订阅消息模板 ID（在微信公众平台申请模板后填入）
WECHAT_MINIAPP_DAILY_REMINDER_TEMPLATE_ID=""
WECHAT_MINIAPP_TASK_COMPLETED_TEMPLATE_ID=""
WECHAT_MINIAPP_DEADLINE_WARNING_TEMPLATE_ID=""

# 数据库备份 / 异地容灾（scripts/db-backup.sh 使用，可选）
# 配置 COS_BUCKET 后将把每日备份同步到腾讯云 COS（需在服务器安装 coscli）
# BACKUP_DIR="/opt/quxueban/backups"
# RETENTION_DAYS="14"
# COS_BUCKET="your-bucket-appid"
# COS_PREFIX="quxueban/db-backups"

# Sentry 错误监控（可选，配置 DSN 后启用）
# 服务端/客户端共用 DSN；未配置时 Sentry 自动禁用，不影响运行
NEXT_PUBLIC_SENTRY_DSN=""
# 上传 sourcemap 所需（仅 CI/构建阶段使用，运行时不需要）
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="quxueban"
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"
