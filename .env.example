# 趣学伴 1.0 生产环境变量模板
# 复制本文件为 .env.production 并替换所有占位值

# PostgreSQL 数据库连接串
# docker-compose 已内置 db 服务，默认使用：postgresql://quxueban:quxueban@db:5432/quxueban?schema=public
DATABASE_URL="postgresql://quxueban@localhost:5432/quxueban?schema=public"

# NextAuth 配置
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="change-me-in-production-min-32-chars-long"

# 首次 prisma/seed.ts 创建的默认管理员账号
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# 钉钉自定义机器人推送配置（全局兜底，可选）
# 建议在每个孩子的编辑页面单独配置钉钉机器人；此处作为未配置孩子时的兜底
DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=xxx"
DINGTALK_SECRET="SECxxx"

# AI 日报总结配置（可选）
# 支持任意 OpenAI 兼容接口，如豆包 Ark、DeepSeek、OpenAI 等
# 未配置时将使用内置规则生成总结
AI_API_BASE="https://ark.cn-beijing.volces.com/api/v3"
AI_API_KEY="your-api-key"
AI_MODEL="doubao-pro-32k"

# 文件上传/持久化配置（local 模式）
# 照片、语音等文件默认保存到 public/uploads，Docker 部署已自动挂载 app_uploads 卷持久化
# 如需使用 S3/OSS 等对象存储，请后续扩展 lib/storage.ts
# UPLOAD_LOCAL_ROOT="/app/public/uploads"
# UPLOAD_PUBLIC_BASE_URL="https://your-domain.com"

# 微信小程序配置（可选）
# 用于小程序端微信登录
WECHAT_MINIAPP_APPID="your-miniapp-appid"
WECHAT_MINIAPP_SECRET="your-miniapp-secret"
# 小程序独立 JWT 密钥，未配置时回退使用 NEXTAUTH_SECRET
MINIAPP_JWT_SECRET="change-me-in-production-min-32-chars-long"
# 微信小程序订阅消息模板 ID（在微信公众平台申请模板后填入）
WECHAT_MINIAPP_DAILY_REMINDER_TEMPLATE_ID=""
WECHAT_MINIAPP_TASK_COMPLETED_TEMPLATE_ID=""
WECHAT_MINIAPP_DEADLINE_WARNING_TEMPLATE_ID=""
