generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(PARENT)
  avatarUrl    String?
  phone        String?
  email        String?
  wechatOpenId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children           Child[]
  plans              Plan[]
  weeklyPlans        WeeklyPlan[]
  notifications      Notification[]
  settings           UserSetting?
  taskTemplates      TaskTemplate[]
  capabilities       Capability[]
  subjectPlanConfigs SubjectPlanConfig[]

  @@index([role])
}

model UserSetting {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme              String  @default("dark-tech")
  fontSize           String  @default("normal")
  density            String  @default("comfortable")
  reducedMotion      Boolean @default(false)
  defaultLandingPage String  @default("dashboard")
  defaultChildMode   String  @default("last")

  notificationPrefs Json    @default("{}")
  reminderTime      String  @default("08:00")
  doNotDisturb      Boolean @default(false)
  doNotDisturbStart String?
  doNotDisturbEnd   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Child {
  id              String    @id @default(uuid())
  userId          String
  name            String
  grade           Int
  educationSystem String    @default("six-three") // 学制：six-three（六三制）或 five-four（五四制）
  avatarColor     String    @default("#f43f5e")
  avatarUrl       String?
  targetSchool    String?
  currentSchool   String?
  birthday        DateTime?
  notes           String?
  routeId         String?
  dingTalkWebhook String? // 钉钉自定义机器人 webhook
  dingTalkSecret  String? // 钉钉机器人加签密钥
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans       Plan[]
  weeklyPlans WeeklyPlan[]

  @@index([userId])
}

model Plan {
  id           String   @id @default(uuid())
  userId       String
  childId      String
  name         String
  type         String
  status       String   @default("draft")
  stage        String
  description  String?
  requirements Json?    @default("[]")
  milestones   Json?    @default("[]")
  targets      Json?    @default("[]")
  probability  Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([childId])
}

model TaskTemplate {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String
  category     TaskCategory
  duration     String       @default("30分钟")
  difficulty   String?      @default("medium")
  materials    String[]     @default([])
  description  String?
  routeTags    String[]     @default([])
  milestoneTag String?
  semesterTag  String?
  tags         String[]     @default([])

  source     TaskTemplateSource @default(USER)
  isActive   Boolean            @default(true)
  archivedAt DateTime?
  useCount   Int                @default(0)
  lastUsedAt DateTime?

  taskType           TaskType           @default(DAILY)
  frequency          TaskFrequency      @default(ONCE)
  customFrequency    Json?
  weeklySchedule     TaskWeeklySchedule @default(AUTO)
  customScheduleDays String[]           @default([])
  assessmentCriteria Json               @default("[]")

  capabilityLinks TaskCapabilityLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([source])
  @@index([archivedAt])
  @@index([isActive])
  @@index([taskType])
  @@index([frequency])
  @@index([weeklySchedule])
}

model Capability {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  category    CapabilityCategory
  description String?
  isSystem    Boolean            @default(false)

  links TaskCapabilityLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isSystem])
}

model TaskCapabilityLink {
  id               String @id @default(uuid())
  taskTemplateId   String
  capabilityId     String
  weight           Float  @default(1.0)
  expectedProgress Float  @default(0.0)

  taskTemplate TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([taskTemplateId, capabilityId])
  @@index([taskTemplateId])
  @@index([capabilityId])
}

model WeeklyPlan {
  id            String    @id @default(uuid())
  userId        String
  childId       String
  weekId        String
  tasks         Json      @default("[]")
  publishedAt   DateTime?
  reviewedAt    DateTime?
  parentComment String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, weekId])
  @@index([userId])
  @@index([childId])
}

enum TaskCategory {
  SCHOOL
  READING
  SPORT
  INTEREST
  ABILITY
  OTHER
}

enum TaskTemplateSource {
  SYSTEM
  USER
}

enum TaskType {
  DAILY
  MILESTONE
  REMEDIAL
  SPRINT
  DIAGNOSTIC
}

enum TaskFrequency {
  ONCE
  DAILY
  WEEKLY
  CUSTOM
}

enum TaskWeeklySchedule {
  AUTO
  DAILY
  WEEKDAYS
  WEEKENDS
  CUSTOM
}

enum CapabilityCategory {
  CHINESE
  MATH
  ENGLISH
  GENERAL
  EXAM
  ADMISSION
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SubjectPlanConfig {
  id              String   @id @default(uuid())
  userId          String?
  subject         String
  tracks          Json
  timeAxis        Json
  nodes           Json
  keyAchievements Json
  examTimeline    Json
  isSystem        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subject, userId])
  @@index([subject])
  @@index([userId])
}

model Publisher {
  id             String  @id @default(uuid())
  name           String  @unique
  shortName      String?
  logoUrl        String?
  website        String?
  strongSubjects String?
  series         String?
  contactEmail   String?
  note           String?

  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model ContentType {
  id              String  @id @default(uuid())
  name            String  @unique
  description     String?
  typicalExamples String?
  usageScenario   String?
  difficultyRange String?

  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Book {
  id                  String    @id @default(uuid())
  bookId              String    @unique
  title               String
  isbn                String?
  author              String?
  editionDate         String?
  editionNumber       String?
  price               Float?
  subject             String
  grade               String
  textbookVersion     String?
  isNewTextbook       String    @default("否")
  difficulty          Int       @default(1)
  targetAudience      String?
  sellingPoints       String?   @db.Text
  structureDesc       String?   @db.Text
  companionSuggestion String?   @db.Text
  coverImageUrl       String?
  jdUrl               String?
  dangdangUrl         String?
  officialUrl         String?
  status              String    @default("在售")
  lastVerifiedAt      DateTime?
  note                String?

  publisher     Publisher   @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  publisherId   String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)
  contentTypeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([grade])
  @@index([status])
  @@index([difficulty])
  @@index([publisherId])
  @@index([contentTypeId])
  @@index([isNewTextbook])
}
